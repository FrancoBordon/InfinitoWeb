generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  imageUrl    String?
  active      Boolean   @default(true)
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String   @default("General")
  price       Float
  costPrice   Float    @default(0)
  promoPrice  Float?
  imageUrl    String?
  images      String?  @default("[]") // JSON array of image URLs: ["url1","url2","url3"]
  stock       Int      @default(0)
  talle       String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  OrderItem[]
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  address   String?
  notes     String?
  tags      String?   // comma-separated tags like "vip,nuevo,frecuente"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  orders    Order[]
}

model Order {
  id          String      @id @default(cuid())
  customerId  String?
  customer    Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName String?
  customerPhone String?
  items       OrderItem[]
  total       Float
  status      String      @default("pending") // pending, confirmed, shipped, delivered, cancelled
  stockReservedUntil DateTime?
  notes       String?
  source      String      @default("whatsapp") // whatsapp, manual
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  @@index([status, stockReservedUntil])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  price     Float
  quantity  Int     @default(1)
  talle     String?
}

model AdminConfig {
  id       String @id @default(cuid())
  key      String @unique
  value    String
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String   @default("Admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
